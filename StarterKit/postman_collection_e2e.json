{
  "info": {
    "name": "KhNTU Lab6 E2E Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"e2e_user_{{$timestamp}}@test.ua\",\n  \"password\": \"Test1234\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('E2E header present', function () {",
              "    pm.response.to.have.header('X-E2E-Suite', 'v6-verified');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login and Save Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@shop.ua\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('E2E header present', function () {",
              "    pm.response.to.have.header('X-E2E-Suite', 'v6-verified');",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set('accessToken', jsonData.data.token);",
              "} else if (jsonData.token) {",
              "    pm.collectionVariables.set('accessToken', jsonData.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Products",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('E2E header present', function () {",
              "    pm.response.to.have.header('X-E2E-Suite', 'v6-verified');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Create Product (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"E2E Test Product\",\n  \"price\": 9999,\n  \"categoryId\": 1\n}"
        },
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 or 200', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('E2E header present', function () {",
              "    pm.response.to.have.header('X-E2E-Suite', 'v6-verified');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create Order (ACID)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 or 200', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('E2E header present', function () {",
              "    pm.response.to.have.header('X-E2E-Suite', 'v6-verified');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ]
}